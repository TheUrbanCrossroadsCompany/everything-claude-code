{
  "name": "biolabs-ep1",
  "version": "1.0.0",
  "private": true,
  "description": "Self-contained Remotion project for the 20/20 BioLabs investor recap episode",
  "scripts": {
    "studio": "remotion studio remotion/index.ts",
    "render": "remotion render remotion/index.ts Episode out/episode.mp4",
    "still": "remotion still remotion/index.ts Episode out/still.png --frame=120",
