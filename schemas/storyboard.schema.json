{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://everything-claude-code/schemas/storyboard.schema.json",
  "title": "Video Episode Storyboard",
  "description": "Single source of truth for one video episode. Claude authors this from a locked brief; ElevenLabs (voice), Kling (b-roll), and the Remotion renderer all read from it. Swap this file for a new subject; keep the same brand kit and render command.",
  "type": "object",
  "required": ["episode", "fps", "width", "height", "brand", "voice", "scenes"],
  "additionalProperties": false,
  "properties": {
    "episode": {
      "type": "object",
      "required": ["title", "slug"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "subject": { "type": "string", "description": "The topic being taught in this episode" },
        "client": { "type": "string", "description": "The brand this episode is produced for" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "targetSeconds": { "type": "number", "minimum": 10 },
        "aspect": { "type": "string", "enum": ["16:9", "9:16", "1:1"], "default": "16:9" }
      }
    },
    "fps": { "type": "integer", "enum": [24, 25, 30, 60], "default": 30 },
    "width": { "type": "integer", "default": 1920 },
    "height": { "type": "integer", "default": 1080 },
    "brand": { "type": "string", "description": "Path to a brand kit JSON validated by brand-kit.schema.json" },
    "voice": {
      "type": "object",
      "required": ["provider", "voiceId"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "enum": ["elevenlabs"] },
        "voiceId": { "type": "string", "description": "Your cloned ElevenLabs voice id" },
        "modelId": { "type": "string", "default": "eleven_multilingual_v2" },
        "stability": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
        "similarityBoost": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.75 },
        "speed": { "type": "number", "minimum": 0.7, "maximum": 1.2, "default": 1 }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "src": { "type": "string" },
        "gainDb": { "type": "number", "default": -22 },
        "duckUnderVoiceDb": { "type": "number", "default": -32, "description": "Bed level while narration plays" }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/scene" }
    }
  },
  "definitions": {
    "scene": {
      "type": "object",
      "required": ["id", "vo"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "vo": {
          "type": "string",
          "description": "Narration for this scene, in spoken form. Must obey the fact-lock: no number or claim that is not in the brief."
        },
        "accent": {
          "type": "string",
          "enum": ["primary", "secondary"],
          "default": "primary",
          "description": "primary = core-business accent; secondary = the reserved secondary thread. Keeps colour semantic, not decorative."
        },
        "background": { "type": "string", "enum": ["ink", "paper"], "default": "paper" },
        "durationSeconds": {
          "type": "number",
          "minimum": 0.5,
          "description": "Filled from the rendered narration length after Stage 2. Drives Remotion scene timing."
        },
        "transition": { "type": "string", "enum": ["cut", "fade", "wipe"], "default": "cut" },
        "graphic": { "$ref": "#/definitions/graphic" },
        "broll": { "$ref": "#/definitions/broll" },
        "notes": { "type": "string" }
      }
    },
    "graphic": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["hero-title", "stat", "stat-row", "split", "chips", "flow", "timeline", "lower-third", "quote", "cta", "none"]
        },
        "props": {
          "type": "object",
          "description": "Shape depends on type; consumed by the matching Remotion component.",
          "additionalProperties": true
        }
      }
    },
    "broll": {
      "type": "object",
      "required": ["prompt"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "enum": ["kling", "still", "none"], "default": "kling" },
        "prompt": { "type": "string" },
        "negativePrompt": { "type": "string" },
        "seed": { "type": "integer", "description": "Fix per series for visual consistency across episodes" },
        "durationSeconds": { "type": "number", "enum": [5, 10], "default": 5 },
        "motion": {
          "type": "string",
          "enum": ["static", "slow-push", "pan-left", "pan-right", "orbit"],
          "default": "slow-push"
        },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 1, "description": "Lower it when the clip sits behind graphics" },
        "file": { "type": "string", "description": "Rendered clip path, written back after Stage 3" }
      }
    }
  }
}
